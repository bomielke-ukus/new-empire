    triggers: [
        (then: [Say("Hold the narrow way between the mountain and the sea. In the pass, numbers count for less. Keep your men at the wall's gap.")]),
        (when: [After(20)], then: [Say("The Medes come first, in their thousands."), Place((kind: "Spearman", owner: 1, at: (32, 2), count: 10)), Place((kind: "Bowman", owner: 1, at: (34, 2), count: 2)), Attack(owner: 1, to: (34, 62))]),
        (when: [After(100)], then: [Say("The Cissians come on behind the Medes."), Place((kind: "Spearman", owner: 1, at: (32, 2), count: 12)), Place((kind: "Bowman", owner: 1, at: (34, 2), count: 3)), Attack(owner: 1, to: (34, 62))]),
        (when: [After(190)], then: [Say("Xerxes sends his own guard, the Immortals, at the wall."), Place((kind: "Swordsman", owner: 1, at: (32, 2), count: 6)), Place((kind: "Bowman", owner: 1, at: (34, 2), count: 3)), Attack(owner: 1, to: (34, 62))]),
        (when: [After(290)], then: [Say("Another wave. The Persians do not run short of men."), Place((kind: "Spearman", owner: 1, at: (32, 2), count: 14)), Place((kind: "Bowman", owner: 1, at: (34, 2), count: 4)), Attack(owner: 1, to: (34, 62))]),
        (when: [After(330)], then: [Say("The Immortals again."), Place((kind: "Swordsman", owner: 1, at: (32, 2), count: 8)), Place((kind: "Bowman", owner: 1, at: (34, 2), count: 3)), Attack(owner: 1, to: (34, 62))]),
        (when: [After(490)], then: [Say("The last of the day's assaults."), Place((kind: "Spearman", owner: 1, at: (32, 2), count: 12)), Place((kind: "Bowman", owner: 1, at: (34, 2), count: 3)), Attack(owner: 1, to: (34, 62))]),
        (id: Some("ephialtes"), when: [After(390)], then: [Say("A man of Trachis, Ephialtes, has shown the Persians a path over the mountain. The Immortals will come down behind you, from the west, onto the road south. Send men to meet them, and keep the wall.")]),
        (when: [Since(trigger: "ephialtes", seconds: 40)], then: [Say("The Immortals are coming down off the mountain!"), Place((kind: "Swordsman", owner: 1, at: (4, 58), count: 6)), Attack(owner: 1, to: (34, 62))]),
        (when: [Inside(owner: 1, area: (from: (26, 60), to: (42, 63)), count: 5)], then: [Lose("The Persians are through the pass, and the road to Greece is open")]),
        (when: [Gone("leonidas")], then: [Fail("leonidas")]),
        (when: [Done("hold"), Not(Failed("leonidas"))], then: [Complete("leonidas")]),
