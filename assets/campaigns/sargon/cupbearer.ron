        (when: [Since(trigger: "founded", seconds: 240)], then: [Say("Men of Kish are coming down the river road to burn Agade!"), Place((kind: "Axeman", owner: 1, at: (54, 18), count: 4)), Place((kind: "Slinger", owner: 1, at: (56, 18), count: 2)), Attack(owner: 1, to: (50, 44))]),
