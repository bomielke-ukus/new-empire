    objectives: [
        (id: "hold", text: "Hold Agade for ten minutes", goal: Survive(seconds: 600)),
        (id: "camps", text: "Destroy the rebels' camps", goal: Scripted, hidden: true),
        (id: "sargon", text: "Sargon must live", goal: Scripted),
    ],
    triggers: [
        (then: [Say("In his old age all the lands rose against Sargon and shut him up in Agade. Hold the walls while the rebels wear themselves out on them.")]),
        (when: [After(30)], then: [Say("The men of Kish come first, from the north."), Place((kind: "Axeman", owner: 1, at: (6, 8), count: 6)), Place((kind: "Bowman", owner: 1, at: (8, 8), count: 3)), Attack(owner: 1, to: (44, 40))]),
        (when: [After(120)], then: [Say("Uruk's army comes up from the south-east."), Place((kind: "Spearman", owner: 1, at: (72, 74), count: 6)), Place((kind: "Bowman", owner: 1, at: (74, 74), count: 4)), Attack(owner: 1, to: (44, 40))]),
        (when: [After(210)], then: [Say("Elam's horsemen ride in from the east."), Place((kind: "Light Cavalry", owner: 1, at: (72, 8), count: 4)), Place((kind: "Bowman", owner: 1, at: (74, 8), count: 4)), Attack(owner: 1, to: (44, 40))]),
        (when: [After(300)], then: [Say("Ur's soldiers come from the south."), Place((kind: "Swordsman", owner: 1, at: (30, 76), count: 6)), Place((kind: "Bowman", owner: 1, at: (32, 76), count: 4)), Attack(owner: 1, to: (44, 40))]),
        (when: [After(390)], then: [Say("Kish again, with more."), Place((kind: "Swordsman", owner: 1, at: (6, 8), count: 6)), Place((kind: "Spearman", owner: 1, at: (8, 8), count: 4)), Attack(owner: 1, to: (44, 40))]),
        (when: [After(480)], then: [Say("Uruk sends its chariots."), Place((kind: "Chariot Archer", owner: 1, at: (72, 74), count: 4)), Place((kind: "Swordsman", owner: 1, at: (74, 74), count: 4)), Attack(owner: 1, to: (44, 40))]),
        (id: Some("last"), when: [After(540)], then: [Say("The last of them: Elam's best."), Place((kind: "Swordsman", owner: 1, at: (72, 8), count: 6)), Place((kind: "Bowman", owner: 1, at: (74, 8), count: 4)), Attack(owner: 1, to: (44, 40))]),
        (when: [Done("hold")], then: [Show("camps"), Say("The rebels are spent. Sargon went out and beat them, the inscriptions say, and made their lands his again. Destroy the rebels' camps."), Reveal((from: (2, 2), to: (12, 10))), Reveal((from: (68, 68), to: (78, 76))), Reveal((from: (26, 70), to: (36, 78))), Reveal((from: (68, 2), to: (78, 10)))]),
        (when: [Done("hold"), Fired("last"), HasAtMost(owner: 1, count: 0)], then: [Complete("camps")]),
        (when: [Gone("agade")], then: [Fail("hold"), Lose("Agade has fallen")]),
        (when: [After(10)], then: [Say("Keep Sargon out of the fighting: if the king falls, Akkad falls. He can shelter in a Town Center or a tower.")]),
        (when: [Gone("sargon")], then: [Fail("sargon"), Lose("Sargon has fallen, and Akkad with him")]),
        (when: [Done("camps")], then: [Complete("sargon")]),
    ],
)
