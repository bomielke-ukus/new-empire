    ],
    objectives: [
        (id: "army", text: "Have 5 clubmen", goal: Have(kind: "Clubman", count: 5)),
        (id: "raid", text: "Drive off the raiders", goal: Scripted, hidden: true),
        (id: "camp", text: "Destroy the Tjehenu camp", goal: Destroy(owner: 2), hidden: true),
        (id: "tc", text: "Keep the Town Center standing", goal: Scripted),
    ],
    triggers: [
        (then: [Say("Choose the barracks and train clubmen. They cost 50 food each, so keep villagers on the berries and the hunt.")]),
        (id: Some("wave1"), when: [Any([Done("army"), After(300)])], then: [Show("raid"), Say("Raiders come out of the desert! Drag a box around your soldiers, then right click an enemy to attack it. Villagers run to the Town Center on their own."), Place((kind: "Clubman", owner: 1, at: (2, 38), count: 4)), Attack(owner: 1, to: (41, 32))]),
        (id: Some("beaten"), when: [Fired("wave1"), HasAtMost(owner: 1, count: 0)], then: [Complete("raid"), Show("camp"), Say("They are beaten. Their camp lies in the desert beyond the dunes. Gather your soldiers and choose ATTACK MOVE on their panel, then click near the camp: they will fight whatever they meet on the way."), Reveal((from: (4, 5), to: (14, 15)))]),
        (when: [Fired("beaten"), After(600)], then: [Say("More raiders! They are making for the Town Center."), Place((kind: "Clubman", owner: 1, at: (2, 38), count: 3)), Place((kind: "Scout", owner: 1, at: (4, 44), count: 2)), Attack(owner: 1, to: (41, 32))]),
        (when: [Done("camp")], then: [Complete("tc")]),
        (when: [HasAtMost(owner: 0, kind: Some("Town Center"), count: 0)], then: [Fail("tc"), Lose("The Town Center has fallen")]),
    ],
)
