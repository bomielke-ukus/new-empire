        (kind: "Town Center", owner: 0, at: (40, 31), tag: Some("tc")),
        (kind: "House", owner: 0, at: (36, 27), count: 2),
        (kind: "Barracks", owner: 0, at: (36, 36)),
        (kind: "Storehouse", owner: 0, at: (45, 16)),
