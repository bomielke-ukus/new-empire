        (kind: "Barracks", owner: 2, at: (30, 6)),
        (kind: "Stable", owner: 2, at: (36, 6)),
        (kind: "House", owner: 2, at: (30, 10), count: 3),
        (kind: "Watch Tower", owner: 2, at: (34, 12)),
        (kind: "Axeman", owner: 2, at: (32, 14), count: 3),
        (kind: "Light Cavalry", owner: 2, at: (37, 9), count: 2),
        (kind: "Bowman", owner: 2, at: (34, 4), count: 2),
    ],
    objectives: [
        (id: "spears", text: "Have 6 spearmen", goal: Have(kind: "Spearman", count: 6)),
        (id: "horses", text: "Beat the Hyksos horsemen", goal: Scripted, hidden: true),
        (id: "slings", text: "Have 6 slingers", goal: Have(kind: "Slinger", count: 6), hidden: true),
        (id: "foot", text: "Beat the Hyksos foot soldiers", goal: Scripted, hidden: true),
        (id: "avaris", text: "Destroy the Hyksos at Avaris", goal: Destroy(owner: 2), hidden: true),
        (id: "tc", text: "Keep the Town Center standing", goal: Scripted),
    ],
    triggers: [
        (then: [Say("The Hyksos fight from horseback, and a horseman rides down a clubman. A spearman is the answer: a long spear does six more damage to anything on a horse. Train spearmen at the barracks.")]),
        (id: Some("riders"), when: [Any([Done("spears"), After(300)])], then: [Show("horses"), Say("Horsemen! Keep your spearmen together and set them on the riders. A soldier's panel, and the tip on its training button, say what it beats and what beats it."), Place((kind: "Light Cavalry", owner: 1, at: (30, 18), count: 3)), Attack(owner: 1, to: (35, 52))]),
        (id: Some("riders_beaten"), when: [Fired("riders"), HasAtMost(owner: 1, count: 0)], then: [Complete("horses"), Show("slings"), Say("The riders are beaten. Now their foot soldiers march, axemen who would cut your spearmen down. A slinger does four more damage to a man on foot, and strikes from a distance. Train slingers at the archery range: they cost stone.")]),
        (id: Some("march"), when: [Fired("riders_beaten"), Any([Done("slings"), After(720)])], then: [Show("foot"), Say("Axemen! Let them come to your slingers, and keep your spearmen in front to hold them."), Place((kind: "Axeman", owner: 1, at: (30, 18), count: 5)), Attack(owner: 1, to: (35, 52))]),
        (when: [Fired("march"), HasAtMost(owner: 1, count: 0)], then: [Complete("foot"), Show("avaris"), Say("Their army is broken. Avaris lies downriver: horsemen, axemen and archers behind a watch tower. Send each of your soldiers against what it beats, and drive the Hyksos out of Egypt."), Reveal((from: (27, 2), to: (42, 16)))]),
        (when: [Done("avaris")], then: [Complete("tc")]),
        (when: [HasAtMost(owner: 0, kind: Some("Town Center"), count: 0)], then: [Fail("tc"), Lose("The Town Center has fallen")]),
    ],
)
