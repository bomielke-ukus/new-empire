    placements: [
        (kind: "Town Center", owner: 0, at: (31, 29), tag: Some("tc")),
        (kind: "Villager", owner: 0, at: (34, 33), count: 3),
        (kind: "Berry Bush", owner: 255, at: (25, 39), count: 4),
        (kind: "Berry Bush", owner: 255, at: (25, 40), count: 3),
