/target
**/*.rs.bk
.DS_Store
/replays/

# Generated art. `cargo run -p atlas -- placeholder` regenerates the placeholder
# sprite sets, and `-- export` regenerates the palette swatch and the .gpl an
# artist imports. Both are derived from assets/palette/ancient.ron, so a
# committed copy can only ever go stale; CI regenerates and validates them.
#
# assets/sprites/ is NOT ignored: that is rendered art, which needs Blender and
# so cannot be regenerated in CI.
/assets/placeholder-sprites/
/assets/palette/*-swatch.png
/assets/palette/*.gpl

# Blender working files. tools/render/*.py are the source: greybox_villager.py
# rebuilds villager.blend from scratch, so a committed .blend is a second copy
# of the model that can silently diverge from the script that made it.
__pycache__/
*.blend1
/tools/render/*.blend
